# Vantage — environment template.
#
# NOTHING LOADS THIS FILE AUTOMATICALLY. Copy it to `.env`, fill in what you need, then either
#   node --env-file=.env --import tsx packages/api/src/server.ts      (local, any entrypoint)
#   docker compose --env-file .env -f deploy/docker-compose.yml up --build
# or export the variables in your shell before `npm run api`.
#
# Everything is optional in development. Optional lines are commented out on purpose: leave a
# line commented rather than setting it to an empty value.
# Every variable the code reads is listed here; `packages/api/src/config.ts` and
# `packages/api/src/context.ts` are where they are consumed.

# ── Core API ────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# Signs sessions. In production the app REFUSES TO BOOT unless this is at least 32 characters
# and not a placeholder (`openssl rand -hex 32`). The value below only works in development.
JWT_SECRET=dev-only-change-me
# Browser origins allowed to call the API. The FIRST one is also the web app's address used in
# emailed links (affiliate sign-in, team invitations, the public join page).
CORS_ORIGINS=http://localhost:5173
# Public address of this API — used in unsubscribe links and OAuth redirect URIs.
PUBLIC_API_URL=http://localhost:8787
# Public address of the tracking edge — used to build tracking links.
TRACKING_BASE_URL=http://localhost:8788
# Which proxies may report the client address (rate limiting, logs). Unset = the socket
# address is the client and X-Forwarded-For is ignored. Behind a reverse proxy or CDN set it
# to that proxy's address/CIDR list (or the names loopback, linklocal, uniquelocal), or every
# client shares one rate-limit bucket. `true` trusts every peer. A hop count is not accepted.
# TRUST_PROXY=
# Request-log level (pino). Default: info in production, off elsewhere.
# LOG_LEVEL=info

# ── Commission / payout defaults ────────────────────────────────────────────
DEFAULT_HOLD_DAYS=14
DEFAULT_MIN_PAYOUT_CENTS=5000
AUTO_APPROVE_CONVERSIONS=true

# ── Persistence ─────────────────────────────────────────────────────────────
# Default runtime is an in-memory store (nothing survives a restart). SETTING DATABASE_URL
# SELECTS POSTGRES for the API, the worker and the edge — they must all get the same URL.
# USE_POSTGRES=true only adds a check that DATABASE_URL is present.
# Back the database up OFF-BOX (PITR to R2/S3).
# DATABASE_URL=postgres://vantage:<password>@localhost:5432/vantage
# USE_POSTGRES=true
# Tests: set to run the Postgres-backed suites (transactions, locks, unique constraints).
# They are skipped when unset. Use a throwaway database — the suites create and drop tables.
# TEST_DATABASE_URL=postgres://vantage:<password>@localhost:5432/vantage_test

# ── Development helpers ─────────────────────────────────────────────────────
# Seed a demo tenant at boot (idempotent) and print its login. Never set in production.
# SEED_DEMO=true
# Run the recruitment scheduler inside the API process (dev). In production run
# `npm run worker` instead — never both against one database.
# SCHEDULER=true
# SCHEDULER_INTERVAL_MS=60000

# ── Tracking edge (Node entrypoint; Cloudflare Workers uses deploy/wrangler.toml) ──
EDGE_PORT=8788
# Where a tracking link redirects. Required by the Node edge in production. One destination
# for every merchant — a per-offer destination is not modelled yet.
# EDGE_DEFAULT_DEST=https://your-store.example/

# ── Secrets ─────────────────────────────────────────────────────────────────
# Each falls back to a value derived from JWT_SECRET when unset (or empty).
# Encrypts stored mailbox / integration credentials (AES-256-GCM). Changing it makes existing
# stored credentials unreadable — set it once, before connecting mailboxes.
# SECRETS_ENC_KEY=
# Signs the public unsubscribe link.
# UNSUBSCRIBE_SECRET=
# Keys the hash API keys are stored under. Changing it invalidates existing API keys.
# API_KEY_PEPPER=
# Shared secret for POST /webhooks/inbound (sent in the `x-webhook-secret` header). In
# production the route answers 503 until this is set.
# INBOUND_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Recruitment mail is sent from the MERCHANT's connected mailbox, never this server.
# Transactional mail (affiliate sign-in links, activation welcomes, team invitations) goes
# through an ESP. With no key set these emails are not delivered (dev prints nothing either:
# the token is returned in the API response outside production).
# ESP_PROVIDER=resend            # resend | postmark — which key to prefer when both are set
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# The From address for transactional mail — one you have verified with the ESP. Required
# for Resend/Postmark sends.
# TRANSACTIONAL_FROM=no-reply@yourdomain.example
# Slack Incoming-Webhook URL for AI-SDR handoff nudges. The in-app queue is the source of truth.
# SLACK_WEBHOOK_URL=

# ── Mailbox OAuth (connect a merchant's Microsoft / Google mailbox) ─────────
# Redirect URIs: {PUBLIC_API_URL}/oauth/microsoft/callback and .../oauth/google/callback.
# Microsoft Graph (delegated Mail.Send + Mail.Read) works while unverified. Gmail-via-Google
# can send but its replies are not read yet, so follow-ups stay on hold for those mailboxes —
# use the Gmail app-password (SMTP + IMAP) path for Gmail today.
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Scraping ────────────────────────────────────────────────────────────────
# Rotating/residential proxy pool, comma-separated. When set, a fetch that cannot go through
# a proxy FAILS — it never falls back to this server's own IP.
# PROXY_URL=
# Escalate to a headless browser only when a page looks blocked. Needs:
#   npm install playwright && npx playwright install chromium
# BROWSER_FETCH=true

# ── Discovery providers (all optional) ──────────────────────────────────────
# With none set, discovery runs deterministic generators and labels every result demo data.
# Competitor backlink mining + real Google SERP (pay-as-you-go).
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Real SERP via SerpApi (alternative to DataForSEO's SERP).
# SERPAPI_KEY=
# Instagram / TikTok / X public counts through a scraping-API actor. The request contract is
# unverified against any vendor — expect to adapt `ScrapeMetricsEnricher` on first use.
# SCRAPE_API_URL=
# SCRAPE_API_KEY=
# YouTube Data API (free): channel discovery, reach and engagement.
# YOUTUBE_API_KEY=
# Hunter.io: email finding / verification. Without it a prospect with no published address
# simply has no contact — addresses are never guessed for real prospects.
# HUNTER_API_KEY=
# Allow the demo generators. Default: on outside production, OFF in production.
# ALLOW_SYNTHETIC_DISCOVERY=false

# ── LLM ─────────────────────────────────────────────────────────────────────
# AI-SDR, reply classification and outreach personalization (Claude Opus 4.8).
# ANTHROPIC_API_KEY=
# Niche-relevance scoring on a cheap model. Precedence: RELEVANCE_LLM_* → ANTHROPIC_API_KEY
# (Claude Haiku 4.5) → an offline lexical scorer. Any OpenAI-compatible endpoint works.
# RELEVANCE_LLM_API_KEY=
# RELEVANCE_LLM_BASE_URL=https://api.x.ai/v1
# RELEVANCE_LLM_MODEL=grok-4-fast-non-reasoning

# ── Web app (build time) ────────────────────────────────────────────────────
# API origin baked into the SPA. Unset = "/api" (the Vite dev proxy).
# VITE_API_BASE=https://api.yourdomain.example

# ── docker-compose only (deploy/docker-compose.yml) ─────────────────────────
# Required by the compose file. URL-safe characters only (`openssl rand -hex 24`).
# POSTGRES_PASSWORD=
# Host address the API and edge are published on. Default 127.0.0.1 (put a TLS proxy in front).
# BIND_ADDRESS=127.0.0.1

# Payout rails: there are deliberately NO platform-wide payout credentials. Money never passes
# through the platform — merchants pay affiliates from their own account (see README).
